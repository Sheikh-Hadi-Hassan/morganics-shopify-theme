{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign category_label = product.type | default: product.vendor | default: 'Morganics'
  assign sku_label = current_variant.sku | default: product.handle
  assign short_description = product.metafields.custom.short_description | default: product.description | strip_html | truncate: 220
  assign urdu_name = product.metafields.custom.urdu_name | default: product.metafields.custom.urduName
  assign use_cases = product.metafields.custom.use_cases | default: product.metafields.custom.useCases
  assign benefits = product.metafields.custom.benefits
  assign usage = product.metafields.custom.usage
  assign storage = product.metafields.custom.storage
  assign precautions = product.metafields.custom.precautions
  assign faqs = product.metafields.custom.faq_s | default: product.metafields.custom.faqs
  assign category_copy = product.metafields.custom.category_copy | default: section.settings.category_copy
  assign category_title = product.metafields.custom.category_title | default: category_label
    assign enable_powder_form = true
    if product.metafields.custom.enable_powder_form.value == true
      assign enable_powder_form = true
    endif

    assign powder_excluded_product = false
    assign powder_exclusion_title = product.title | downcase
    if powder_exclusion_title contains 'maghaz badam gurbandi' or powder_exclusion_title contains 'dar chini gol' or powder_exclusion_title contains 'goond katira' or powder_exclusion_title contains 'anjeer' or powder_exclusion_title contains 'fig' or powder_exclusion_title contains 'maghaz chilgoza half roasted' or powder_exclusion_title contains 'maghaz chilgoza full roasted' or powder_exclusion_title contains 'maghaz akhrot' or powder_exclusion_title contains 'walnut' or powder_exclusion_title contains 'banana dried' or powder_exclusion_title contains 'mabroom dates' or powder_exclusion_title contains 'khajoor ajwa' or powder_exclusion_title contains 'mixed berries' or powder_exclusion_title contains 'cranberry' or powder_exclusion_title contains 'honey' or powder_exclusion_title contains 'luban' or powder_exclusion_title contains 'sogi gol mewa' or powder_exclusion_title contains 'pista namkeen' or powder_exclusion_title contains 'sarson black' or powder_exclusion_title contains 'elaichi sabz' or powder_exclusion_title contains 'gur' or powder_exclusion_title contains 'chilka ispaghol' or powder_exclusion_title contains 'kajo fry' or powder_exclusion_title contains 'kajo roasted' or powder_exclusion_title contains 'kajo plain' or powder_exclusion_title contains 'til black' or powder_exclusion_title contains 'zarishk' or powder_exclusion_title contains 'harmal' or powder_exclusion_title contains 'saffron' or powder_exclusion_title contains 'pista maghaz' or powder_exclusion_title contains 'shakar' or powder_exclusion_title contains 'sogi sundarhani mewa' or powder_exclusion_title contains 'badam abdul wahidi' or powder_exclusion_title contains 'kali darakh' or powder_exclusion_title contains 'goji berry' or powder_exclusion_title contains 'musabbar' or powder_exclusion_title contains 'salajeet' or powder_exclusion_title contains 'hibiscus herb' or powder_exclusion_title contains 'sunflower seeds' or powder_exclusion_title contains 'maghaz sunflower seeds'
      assign powder_excluded_product = true
    endif
    if powder_excluded_product
      assign enable_powder_form = false
    endif
  assign has_powder_variants = false
  for variant in product.variants
    for option_value in variant.options
      assign option_key = option_value | strip | downcase
      if option_key == 'powder'
        assign has_powder_variants = true
      endif
    endfor
  endfor
  assign description_html = product.description
  assign visible_description = description_html | split: '<h2>FAQs</h2>' | first
  assign visible_description = visible_description | split: '<h2>FAQ</h2>' | first
  assign visible_description = visible_description | split: '<h3>FAQs</h3>' | first
  assign visible_description = visible_description | split: '<h3>FAQ</h3>' | first
  assign visible_description = visible_description | split: '<h2>Faqs</h2>' | first
  assign visible_description = visible_description | split: '<h3>Faqs</h3>' | first
  assign visible_description = visible_description | split: '<strong>FAQs</strong>' | first
  assign visible_description = visible_description | split: '<strong>FAQ</strong>' | first
  assign visible_description = visible_description | split: '<b>FAQs</b>' | first
  assign visible_description = visible_description | split: '<b>FAQ</b>' | first
  assign visible_description = visible_description | split: '<p>FAQs</p>' | first
  assign visible_description = visible_description | split: '<p>FAQ</p>' | first
  assign visible_description = visible_description | split: 'FAQs' | first
  assign visible_description = visible_description | split: 'FAQ' | first
  assign visible_description = visible_description | split: '1. Q:' | first
  assign visible_description = visible_description | split: '1) Q:' | first
  assign visible_description = visible_description | split: 'Q:' | first
  assign description_faq_source = description_html | strip_html
%}

<section
  class="product-detail"
  data-morganics-product
  data-product-faq-source="{{ faqs.value | default: faqs | escape }}"
  data-product-description-faq-source="{{ description_faq_source | escape }}"
  data-product-variants="{{ product.variants | json | escape }}"
>
  <div
    class="detail-image product-media-gallery reveal"
    data-product-media-gallery
    aria-label="{{ product.title | escape }} media gallery"
  >
    <div class="product-media-gallery__stage" data-gallery-stage tabindex="0">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          {% liquid
            assign is_active_media = false
            assign media_loading = 'lazy'
            if media.id == featured_media.id
              assign is_active_media = true
            elsif featured_media == blank and forloop.first
              assign is_active_media = true
            endif
            if forloop.first
              assign media_loading = 'eager'
            endif
          %}
          <div
            class="product-media-gallery__slide{% if is_active_media %} is-active{% endif %}"
            data-gallery-slide
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            role="group"
            aria-label="{{ forloop.index }} of {{ product.media.size }}"
            aria-hidden="{% if is_active_media %}false{% else %}true{% endif %}"
            {% unless is_active_media %}hidden{% endunless %}
          >
            {% case media.media_type %}
              {% when 'image' %}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    loading: media_loading,
                    widths: '480, 720, 960, 1200, 1500, 1800',
                    sizes: '(min-width: 1181px) 46vw, 92vw',
                    alt: media.alt | default: product.title
                }}
              {% when 'video' %}
                {{
                  media
                  | video_tag:
                    controls: false,
                    autoplay: false,
                    muted: true,
                    loop: false,
                    playsinline: true,
                    preload: 'metadata',
                    image_size: '1400x'
                }}
                <div class="product-media-gallery__video-controls" data-video-controls>
                  <button type="button" data-video-play aria-label="Play video">
                    <span data-play-icon aria-hidden="true">▶</span>
                  </button>
                  <button type="button" data-video-mute aria-label="Unmute video">
                    <span data-mute-icon aria-hidden="true">⌁</span>
                  </button>
                </div>
              {% when 'external_video' %}
                <div class="product-media-gallery__external-video">
                  {{ media | external_video_tag: loading: 'lazy' }}
                </div>
              {% when 'model' %}
                {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            {% endcase %}
          </div>
        {% endfor %}

        {% if product.media.size > 1 %}
          <button class="product-media-gallery__arrow product-media-gallery__arrow--prev" type="button" data-gallery-prev aria-label="Previous media">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
          </button>
          <button class="product-media-gallery__arrow product-media-gallery__arrow--next" type="button" data-gallery-next aria-label="Next media">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
          </button>
          <span class="product-media-gallery__counter" aria-live="polite">
            <span data-gallery-current>1</span><span aria-hidden="true">/</span><span>{{ product.media.size }}</span>
          </span>
        {% endif %}
      {% elsif product.featured_image %}
        {{ product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', alt: product.title }}
      {% else %}
        {% render 'morganics-product-image-fallback', product: product, width: 1200, height: 900, loading: 'eager' %}
      {% endif %}
    </div>

    {% if product.media.size > 1 %}
      <div class="product-media-gallery__thumb-shell">
        <button class="product-media-gallery__thumb-scroll" type="button" data-thumb-prev aria-label="Scroll thumbnails left">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
        </button>
        <div class="product-media-gallery__thumbs" data-gallery-thumbs>
          {% for media in product.media %}
            <button
              class="product-media-gallery__thumb{% if media.id == featured_media.id or featured_media == blank and forloop.first %} is-active{% endif %}"
              type="button"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              aria-label="Show {{ media.media_type }} {{ forloop.index }} of {{ product.media.size }}"
              aria-current="{% if media.id == featured_media.id or featured_media == blank and forloop.first %}true{% else %}false{% endif %}"
            >
              {{
                media.preview_image
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '90, 120, 180',
                  sizes: '72px',
                  alt: media.alt | default: product.title
              }}
              {% unless media.media_type == 'image' %}
                <span class="product-media-gallery__thumb-type" aria-hidden="true">
                  {% if media.media_type == 'model' %}3D{% else %}▶{% endif %}
                </span>
              {% endunless %}
            </button>
          {% endfor %}
        </div>
        <button class="product-media-gallery__thumb-scroll" type="button" data-thumb-next aria-label="Scroll thumbnails right">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
    {% endif %}

    {% if product.collections.first %}
      <a class="back-chip" href="{{ product.collections.first.url }}">← {{ product.collections.first.title }}</a>
    {% else %}
      <a class="back-chip" href="{{ routes.all_products_collection_url }}">← Shop</a>
    {% endif %}
  </div>

  <div class="detail-content reveal">
    <span class="eyebrow">{{ category_label }} · {{ sku_label }}</span>
    <h1 data-urdu-wrap>{{ product.title }}</h1>
    {% if urdu_name != blank %}<div class="urdu-name morganics-urdu" lang="ur" dir="rtl">{{ urdu_name }}</div>{% endif %}

    <div class="detail-price">{% render 'morganics-price', product: product, variant: current_variant %}</div>

    {% if short_description != blank %}
      <p data-urdu-wrap>{{ short_description }}</p>
    {% endif %}

    <div class="buy-box mrg-stack">
      {% form 'product', product %}
        <h3>Choose Pack</h3>

        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% else %}
          {% render 'morganics-variant-pills', product: product %}
        {% endif %}

        {% comment %}
          Powder Form visibility is intentionally product-specific.
          It is controlled by the boolean product metafield custom.enable_powder_form.
          False, blank, or missing metafield values mean the Powder Form control stays hidden.
          The product must also include at least one existing Powder variant before this renders.
        {% endcomment %}
        {% if enable_powder_form and has_powder_variants %}
          {% liquid
            assign powder_label = section.settings.powder_label | default: 'Powder Form'
            unless powder_label contains '+Rs'
              assign powder_label = powder_label | append: ' (+Rs.100)'
            endunless
          %}
          <label class="powder-toggle mrg-control">
            <input type="checkbox"
              name="properties[Powder Form]"
              value="Yes"
              data-powder-toggle
            >
            <span>{{ powder_label }}</span>
          </label>
        {% endif %}

        <div class="qty-row mrg-control" data-quantity-row>
          <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
          <input id="Quantity-{{ section.id }}" name="quantity" value="1" type="number" min="1" inputmode="numeric">
          <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
        </div>

        <button class="btn primary mrg-btn mrg-btn--primary add-cart-btn" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add-to-cart>
          {% if current_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
        </button>

        {% if section.settings.show_dynamic_checkout %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}
    </div>

<script src="{{ 'morganics-product.js' | asset_url }}" defer></script>
<script src="{{ 'morganics-product-gallery.js' | asset_url }}" defer></script>

    <div class="feature-icons">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>

    <div class="detail-grid">
      {% render 'morganics-info-box', title: section.settings.use_cases_title, list: use_cases, fallback: section.settings.use_cases_fallback %}
      {% render 'morganics-info-box', title: section.settings.benefits_title, list: benefits, fallback: section.settings.benefits_fallback %}
      {% render 'morganics-info-box', title: section.settings.usage_title, content: usage, fallback: section.settings.usage_fallback %}
      {% render 'morganics-info-box', title: section.settings.storage_title, content: storage, fallback: section.settings.storage_fallback %}
      {% render 'morganics-info-box', title: section.settings.precautions_title, content: precautions, fallback: section.settings.precautions_fallback %}
    </div>

    {% if visible_description != blank %}
      <div class="description-html" data-product-description data-urdu-wrap>{{ visible_description }}</div>
    {% endif %}

    {%- render 'morganics-faq-accordion', faqs: faqs, section: section, heading: section.settings.faq_heading -%}
  </div>
</section>

<section class="product-category-band" style="--banner:url({{ 'morganics-banners-nuts-dry-fruits.jpg' | asset_url }})">
  <div>
    <span class="eyebrow">{{ section.settings.category_eyebrow }} {{ category_label }}</span>
    <h2>{{ category_title }}</h2>
    <p>{{ category_copy }}</p>
    {% if product.collections.first %}
      <a class="btn ghost mrg-btn mrg-btn--ghost" href="{{ product.collections.first.url }}">Open category</a>
    {% endif %}
  </div>
</section>

{% if product.collections.first and section.settings.show_related_products %}
  <section class="section mrg-section mrg-section--compact">
    <div class="section-head mrg-container">
      <span class="eyebrow">{{ section.settings.related_eyebrow }}</span>
      <h2>{{ section.settings.related_heading }} {{ product.collections.first.title }}</h2>
    </div>
    <div class="product-grid morganics-product-grid mrg-product-grid mrg-product-grid--related mrg-container">
      {% for related_product in product.collections.first.products limit: 4 %}
        {% unless related_product.id == product.id %}
          {% render 'morganics-product-card', product: related_product, show_quick_add: true, view_label: 'View Details' %}
        {% endunless %}
      {% endfor %}
    </div>
  </section>
{% endif %}



{% schema %}
{
  "name": "Morganics product",
  "settings": [
    { "type": "text", "id": "powder_label", "label": "Powder option label", "default": "Powder Form (+Rs.100)" },
    { "type": "text", "id": "powder_help", "label": "Powder option help", "default": "If you want this product powdered before packing." },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": false },
    { "type": "text", "id": "use_cases_title", "label": "Use cases title", "default": "Best Use Cases" },
    { "type": "textarea", "id": "use_cases_fallback", "label": "Use cases fallback", "default": "Daily pantry use\nTea-time serving\nGift-friendly routines" },
    { "type": "text", "id": "benefits_title", "label": "Benefits title", "default": "Key Benefits" },
    { "type": "textarea", "id": "benefits_fallback", "label": "Benefits fallback", "default": "Freshness-led packing\nPractical usage guidance\nPremium pantry selection" },
    { "type": "text", "id": "usage_title", "label": "Usage title", "default": "How to Use" },
    { "type": "textarea", "id": "usage_fallback", "label": "Usage fallback", "default": "Use as a snack, add to breakfast bowls, desserts, milk, tea or recipes depending on product type. Use herbs and botanicals in small sensible amounts according to familiar practice or qualified guidance." },
    { "type": "text", "id": "storage_title", "label": "Storage title", "default": "Storage" },
    { "type": "textarea", "id": "storage_fallback", "label": "Storage fallback", "default": "Keep sealed in a cool, dry place away from sunlight, heat and moisture. Use clean, dry utensils. Refrigerate sensitive opened packs in hot or humid weather where needed." },
    { "type": "text", "id": "precautions_title", "label": "Precautions title", "default": "Precautions" },
    { "type": "textarea", "id": "precautions_fallback", "label": "Precautions fallback", "default": "This is a pantry product and not medical advice. Avoid if allergic. Use specialty herbs and botanicals with professional guidance if pregnant, nursing, medicated or managing a health condition." },
    { "type": "text", "id": "category_eyebrow", "label": "Category band eyebrow", "default": "More in" },
    { "type": "textarea", "id": "category_copy", "label": "Category band fallback copy", "default": "Explore more Morganics pantry products with freshness-led packing, practical usage guidance, storage notes and careful product information." },
    { "type": "checkbox", "id": "show_related_products", "label": "Show related products", "default": true },
    { "type": "text", "id": "related_eyebrow", "label": "Related eyebrow", "default": "Related Products" },
    { "type": "text", "id": "related_heading", "label": "Related heading prefix", "default": "More from" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Questions about this product" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Natural pantry product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Morganics product",
      "blocks": [
        { "type": "feature", "settings": { "text": "Natural pantry product" } },
        { "type": "feature", "settings": { "text": "Shopify checkout ready" } },
        { "type": "feature", "settings": { "text": "Care guidance included" } },
        { "type": "feature", "settings": { "text": "Gift-friendly category" } }
      ]
    }
  ]
}
{% endschema %}
