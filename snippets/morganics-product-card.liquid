{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign secondary_image = blank
  if product.images.size > 1
    for image in product.images
      if image.id != product.featured_image.id
        assign secondary_image = image
        break
      endif
    endfor
  endif
  assign product_tags_filter = product.tags | join: ' '
  capture product_collections_filter
    for product_collection in product.collections
      echo product_collection.handle
      echo ' '
      echo product_collection.title
      echo ' '
    endfor
  endcapture
  capture product_variant_filter
    for variant in product.variants
      echo variant.title
      echo ' '
      echo variant.sku
      echo ' '
    endfor
  endcapture
  assign product_size_filter = product_variant_filter | append: ' ' | append: product_tags_filter
%}

<div
  class="product-card-wrap mrg-product-card"
  data-product-card
  data-filter-card
  data-product-id="{{ product.id }}"
  data-title="{{ product.title | escape }}"
  data-sku="{{ current_variant.sku | escape }}"
  data-tags="{{ product_tags_filter | escape }}"
  data-product-type="{{ product.type | handleize }}"
  data-category="{{ product.title | append: ' ' | append: product.type | append: ' ' | append: product_tags_filter | append: ' ' | append: product_collections_filter | strip | escape }}"
  data-collections="{{ product_collections_filter | strip | escape }}"
  data-price="{{ product.price }}"
  data-available="{% if product.available %}true{% else %}false{% endif %}"
  data-variants="{{ product_variant_filter | strip | escape }}"
  data-sizes="{{ product_size_filter | strip | escape }}"
  data-created-at="{{ product.created_at | date: '%s' }}"
>
  <button
    class="product-card-wishlist morganics-favorite-toggle"
    type="button"
    aria-label="Add {{ product.title | escape }} to wishlist"
    aria-pressed="false"
    data-favorite-toggle
    data-wishlist-product
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-product-url="{{ product.url }}"
    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 }}{% endif %}"
    data-product-price="{{ product.price | money }}"
    data-variant-id="{{ current_variant.id }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.8 4.6c-1.8-1.8-4.7-1.8-6.5 0L12 6.9 9.7 4.6c-1.8-1.8-4.7-1.8-6.5 0s-1.8 4.7 0 6.5L12 20l8.8-8.9c1.8-1.8 1.8-4.7 0-6.5Z"></path>
    </svg>
  </button>
  <a class="product-card morganics-product-card mrg-product-card__link" href="{{ product.url }}">
    <div class="product-img mrg-product-card__media{% if secondary_image != blank %} has-secondary-image{% endif %}">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'product-img-primary' }}
        {% if secondary_image != blank %}
          {{ secondary_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title, class: 'product-img-secondary' }}
        {% endif %}
      {% else %}
        {% render 'morganics-product-image-fallback', product: product, width: 700, height: 700, loading: 'lazy' %}
      {% endif %}
    </div>
    <div class="product-info mrg-product-card__content">
      <b class="product-name mrg-product-card__title" data-urdu-wrap>{{ product.title }}</b>
      {% if product.metafields.custom.urdu_name != blank %}
        <span class="urdu-line" data-urdu-wrap>{{ product.metafields.custom.urdu_name }}</span>
      {% endif %}

      {% if product.description != blank %}
        <p class="product-card-summary">{{ product.description | strip_html | truncatewords: 20 }}</p>
      {% endif %}

      {% liquid
        assign regular_variant_count = 0
        for variant in product.variants
          assign card_variant_is_powder = false
          for option_value in variant.options
            assign card_option_key = option_value | strip | downcase
            if card_option_key == 'powder'
              assign card_variant_is_powder = true
            endif
          endfor
          assign card_variant_title_downcase = variant.title | downcase
          if card_variant_title_downcase contains 'powder'
            assign card_variant_is_powder = true
          endif
          unless card_variant_is_powder
            assign regular_variant_count = regular_variant_count | plus: 1
          endunless
        endfor
      %}

      {% if regular_variant_count > 1 %}
        <div class="product-card-variants-row" data-desktop-only>
          {% assign displayed_regular_variant_count = 0 %}
          {% for variant in product.variants %}
            {% liquid
              assign card_variant_is_powder = false
              assign card_variant_label = ''
              for option_value in variant.options
                assign card_option_key = option_value | strip | downcase
                if card_option_key == 'powder'
                  assign card_variant_is_powder = true
                elsif card_option_key == 'regular'
                  continue
                else
                  if card_variant_label != blank
                    assign card_variant_label = card_variant_label | append: ' / '
                  endif
                  assign card_variant_label = card_variant_label | append: option_value
                endif
              endfor
              assign card_variant_title_downcase = variant.title | downcase
              if card_variant_title_downcase contains 'powder'
                assign card_variant_is_powder = true
              endif
              if card_variant_label == blank
                assign card_variant_label = variant.title | replace: ' / Regular', '' | replace: ' / Powder', '' | replace: 'Regular / ', '' | replace: 'Powder / ', '' | replace: ' - Regular', '' | replace: ' - Powder', ''
              endif
            %}
            {% unless card_variant_is_powder %}
              {% if displayed_regular_variant_count < 2 %}
                {% if displayed_regular_variant_count > 0 %}<span class="variant-separator">•</span>{% endif %}
                <span class="variant-item-pill">{{ card_variant_label }} {{ variant.price | money }}</span>
                {% assign displayed_regular_variant_count = displayed_regular_variant_count | plus: 1 %}
              {% endif %}
            {% endunless %}
          {% endfor %}
          {% if regular_variant_count > displayed_regular_variant_count %}
            <span class="variant-separator">•</span>
            <span class="variant-more-count">+{{ regular_variant_count | minus: displayed_regular_variant_count }} more</span>
          {% endif %}
        </div>
      {% endif %}

      <div class="price-row mrg-product-card__price">
        <div class="price-container">
          <span class="price{% if product.compare_at_price > product.price %} price-sale{% endif %}">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <s class="price-compare">{{ product.compare_at_price | money }}</s>
          {% endif %}
        </div>
      </div>
    </div>
  </a>

  {% if show_quick_add and product.available %}
    {% form 'product', product, class: 'card-actions mrg-product-card__actions' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      <button class="card-cart-btn mrg-product-card__cart" type="submit">Add to Cart</button>
      <a class="card-view-btn mrg-product-card__view" href="{{ product.url }}">{{ view_label | default: 'View' }}</a>
    {% endform %}
  {% elsif show_quick_add %}
    <div class="card-actions mrg-product-card__actions">
      <button class="card-cart-btn mrg-product-card__cart" type="button" disabled>Sold Out</button>
      <a class="card-view-btn mrg-product-card__view" href="{{ product.url }}">{{ view_label | default: 'View' }}</a>
    </div>
  {% endif %}

</div>
