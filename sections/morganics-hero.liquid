{{ 'morganics-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign enabled_slide_count = 0
  for block in section.blocks
    if block.type == 'slide' and block.settings.enabled
      assign enabled_slide_count = enabled_slide_count | plus: 1
    endif
  endfor
%}

<section
  class="morganics-hero hero-v3 morganics-hero-slider morganics-hero-slider--{{ section.settings.transition_style }}"
  id="MorganicsHero-{{ section.id }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  data-morganics-hero-slider="{{ section.id }}"
  data-hero-slider
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  data-burst-glow="{{ section.settings.enable_ingredient_burst_glow }}"
  style="--hero-stage-max: {{ section.settings.stage_max_width }}px; --ingredient-safe: {{ section.settings.ingredient_safe_margin }}px; --ingredient-zone-desktop-top: {{ section.settings.ingredient_zone_desktop_top }}%; --ingredient-zone-desktop-right: {{ section.settings.ingredient_zone_desktop_right }}%; --ingredient-zone-desktop-bottom: {{ section.settings.ingredient_zone_desktop_bottom }}%; --ingredient-zone-desktop-left: {{ section.settings.ingredient_zone_desktop_left }}%; --ingredient-zone-mobile-top: {{ section.settings.ingredient_zone_mobile_top }}%; --ingredient-zone-mobile-right: {{ section.settings.ingredient_zone_mobile_right }}%; --ingredient-zone-mobile-bottom: {{ section.settings.ingredient_zone_mobile_bottom }}%; --ingredient-zone-mobile-left: {{ section.settings.ingredient_zone_mobile_left }}%; --slide-overlay-default: {{ section.settings.background_overlay_strength | divided_by: 100.0 }}; --hero-transition-ms: {{ section.settings.transition_speed }}ms;"
>
  <div class="mhs-slides" aria-live="off">
    {% assign rendered_slide_index = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'slide' and block.settings.enabled %}
        {% assign slide_handle = block.settings.slide_handle | handleize %}
        {% if slide_handle == blank %}
          {% assign slide_handle = 'slide-' | append: block.id %}
        {% endif %}
        {% assign rendered_slide_index = rendered_slide_index | plus: 1 %}
        {% assign is_active = false %}
        {% if rendered_slide_index == 1 %}{% assign is_active = true %}{% endif %}

        <article
          class="mhs-slide{% if is_active %} is-active{% endif %}"
          data-mhs-slide
          data-slide-index="{{ rendered_slide_index | minus: 1 }}"
          data-slide-handle="{{ slide_handle }}"
          data-duration="{{ block.settings.duration }}"
          data-block-id="{{ block.id }}"
          aria-hidden="{% if is_active %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="mhs-slide-background" aria-hidden="true">
            {% if block.settings.background_image != blank %}
              {{ block.settings.background_image | image_url: width: 2400 | image_tag: class: 'mhs-background-image', loading: 'eager', widths: '960, 1440, 1920, 2400', sizes: '100vw' }}
            {% else %}
              <img class="mhs-background-image" src="{{ 'morganics-morganics-hero-bg-gradient.png' | asset_url }}" alt="" width="1672" height="941" loading="eager">
            {% endif %}
            <span class="mhs-background-overlay" style="--slide-overlay: {{ block.settings.overlay_strength | divided_by: 100.0 }};"></span>
          </div>

          <div class="mhs-stage-layer">
            <div class="mhs-stage" data-mhs-stage>
              <div class="mhs-stage-safe">
                <div class="mhs-product-stack" data-product-stack>
                  {% if block.settings.stone_image != blank %}
                    {{ block.settings.stone_image | image_url: width: 1600 | image_tag: class: 'mhs-product-layer mhs-stone', loading: 'eager', alt: '' }}
                  {% else %}
                    <img class="mhs-product-layer mhs-stone" src="{{ 'morganics-morganics-hero-stone.png' | asset_url }}" alt="" width="2576" height="1374" loading="eager">
                  {% endif %}
                  <span class="mhs-contact-shadow" aria-hidden="true"></span>
                  <span class="mhs-burst-glow" aria-hidden="true"></span>
                  {% if block.settings.pouch_image != blank %}
                    {{ block.settings.pouch_image | image_url: width: 1100 | image_tag: class: 'mhs-product-layer mhs-pouch', loading: 'eager', fetchpriority: 'high', alt: block.settings.pouch_alt }}
                  {% else %}
                    <img class="mhs-product-layer mhs-pouch" src="{{ 'morganics-morganics-hero-pouch.png' | asset_url }}" alt="{{ block.settings.pouch_alt | escape }}" width="1557" height="2274" loading="eager" fetchpriority="high">
                  {% endif %}
                  {% if block.settings.pile_image != blank %}
                    {{ block.settings.pile_image | image_url: width: 1300 | image_tag: class: 'mhs-product-layer mhs-pile', loading: 'eager', alt: '' }}
                  {% else %}
                    <img class="mhs-product-layer mhs-pile" src="{{ 'morganics-morganics-hero-dryfruit-pile.png' | asset_url }}" alt="" width="1536" height="1024" loading="eager">
                  {% endif %}
                  {% if block.settings.foreground_image != blank %}
                    {{ block.settings.foreground_image | image_url: width: 1200 | image_tag: class: 'mhs-product-layer mhs-foreground', loading: 'eager', alt: '' }}
                  {% endif %}
                </div>

                <div class="mhs-floating-field hero-ingredients-safe-zone" data-floating-field>
                  {% assign ingredient_count = 0 %}
                  {% for ingredient in section.blocks %}
                    {% assign ingredient_slide_handle = ingredient.settings.slide_handle | handleize %}
                    {% if ingredient.type == 'ingredient' and ingredient_slide_handle == slide_handle %}
                      {% assign ingredient_count = ingredient_count | plus: 1 %}
                      {% assign ingredient_alt = ingredient.settings.alt_text %}
                      {% if ingredient_alt == blank and ingredient.settings.product != blank %}
                        {% assign ingredient_alt = ingredient.settings.product.title %}
                      {% endif %}
                      {% if ingredient_alt == blank %}
                        {% assign ingredient_alt = ingredient.settings.fallback_asset | replace: '-', ' ' | capitalize %}
                      {% endif %}
                      {% assign ingredient_link = ingredient.settings.custom_link %}
                      {% if ingredient_link == blank and ingredient.settings.product != blank %}
                        {% assign ingredient_link = ingredient.settings.product.url %}
                      {% endif %}
                      <button
                        class="mhs-ingredient"
                        type="button"
                        data-mhs-ingredient
                        data-priority="{{ ingredient.settings.priority }}"
                        data-title="{{ ingredient_alt | escape }}"
                        data-link="{{ ingredient_link }}"
                        data-fallback-asset="{{ ingredient.settings.fallback_asset | escape }}"
                        data-product-image="{% if ingredient.settings.product.featured_image %}{{ ingredient.settings.product.featured_image | image_url: width: 360 }}{% endif %}"
                        aria-label="View {{ ingredient_alt | escape }}"
                        {{ ingredient.shopify_attributes }}
                      >
                        {% if ingredient.settings.image != blank %}
                          {{ ingredient.settings.image | image_url: width: 260 | image_tag: class: 'mhs-ingredient-image', loading: 'eager', alt: ingredient_alt }}
                        {% else %}
                          <img class="mhs-ingredient-image" src="{{ ingredient.settings.fallback_asset | append: '.png' | asset_url }}" alt="{{ ingredient_alt | escape }}" width="160" height="160" loading="eager">
                        {% endif %}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>

          <div class="mhs-overlay-ui">
            <div class="mhs-copy">
              <div class="mhs-copy-inner">
                {% if rendered_slide_index == 1 %}
                  <h1 class="mhs-title{% if block.settings.title_line_2.size > 8 %} mhs-title--long{% endif %}">
                    <span class="mhs-title-small">{{ block.settings.title_line_1 | escape }}</span>
                    <span class="mhs-title-large">{{ block.settings.title_line_2 | escape }}</span>
                  </h1>
                {% else %}
                  <h2 class="mhs-title{% if block.settings.title_line_2.size > 8 %} mhs-title--long{% endif %}">
                    <span class="mhs-title-small">{{ block.settings.title_line_1 | escape }}</span>
                    <span class="mhs-title-large">{{ block.settings.title_line_2 | escape }}</span>
                  </h2>
                {% endif %}
                {% if block.settings.description != blank %}
                  <span class="mhs-rule" aria-hidden="true"></span>
                  <p class="mhs-description">{{ block.settings.description | escape | newline_to_br }}</p>
                {% endif %}
                {% if section.settings.show_ctas %}
                  {% if block.settings.primary_cta_label != blank or block.settings.secondary_cta_label != blank %}
                    <div class="mhs-ctas">
                      {% if block.settings.primary_cta_label != blank %}
                        <a class="mhs-cta mhs-cta--primary" href="{{ block.settings.primary_cta_link | default: routes.all_products_collection_url }}">{{ block.settings.primary_cta_label | escape }}</a>
                      {% endif %}
                      {% if block.settings.secondary_cta_label != blank %}
                        <a class="mhs-cta mhs-cta--secondary" href="{{ block.settings.secondary_cta_link | default: routes.all_products_collection_url }}">{{ block.settings.secondary_cta_label | escape }}</a>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </div>

            {% if section.settings.show_tagline %}
              <div class="mhs-tagline">
                <span>{{ block.settings.tagline_small | default: 'Driven by' | escape }}</span>
                <strong>{{ block.settings.tagline_large | default: 'Wellness' | escape }}</strong>
              </div>
            {% endif %}
          </div>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {% if enabled_slide_count > 1 %}
    <nav class="mhs-slide-nav mhs-slide-nav--{{ section.settings.desktop_navigator_position }}" aria-label="Choose a hero slide">
      {% assign nav_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'slide' and block.settings.enabled %}
          {% assign nav_label = block.settings.navigator_title %}
          {% if nav_label == blank or nav_label == 'Use title line 2' %}
            {% assign nav_label = block.settings.title_line_2 %}
          {% endif %}
          <button
            class="mhs-slide-nav-card{% if nav_index == 0 %} is-active{% endif %}"
            type="button"
            data-mhs-nav="{{ nav_index }}"
            aria-label="Show {{ nav_label | escape }} slide"
            aria-current="{% if nav_index == 0 %}true{% else %}false{% endif %}"
          >
            <span class="mhs-slide-nav-icon" aria-hidden="true">
              {% if block.settings.navigator_icon != blank %}
                {{ block.settings.navigator_icon | image_url: width: 160 | image_tag: loading: 'eager', alt: '' }}
              {% else %}
                {% case block.settings.navigator_category_icon %}
                  {% when 'dry-fruits' %}<img src="{{ 'morganics-category-icons-dry-fruits-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% when 'roots' %}<img src="{{ 'morganics-category-icons-roots-adaptogens-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% when 'seeds' %}<img src="{{ 'morganics-category-icons-seeds-grains-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% when 'herbs' %}<img src="{{ 'morganics-category-icons-herbs-botanicals-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% when 'sweeteners' %}<img src="{{ 'morganics-category-icons-natural-sweeteners-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% when 'oils' %}<img src="{{ 'morganics-category-icons-oils-gums-specialties-icon.png' | asset_url }}" alt="" width="72" height="72">
                  {% else %}<img src="{{ 'morganics-category-icons-nuts-icon.png' | asset_url }}" alt="" width="72" height="72">
                {% endcase %}
              {% endif %}
            </span>
            <span class="mhs-slide-nav-label">{{ nav_label | escape }}</span>
          </button>
          {% assign nav_index = nav_index | plus: 1 %}
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}

  <div class="mhs-botanicals" aria-hidden="true">
    <img class="mhs-botanical mhs-botanical--left" src="{{ 'morganics-morganics-hero-plant-left.png' | asset_url }}" alt="" width="577" height="433" loading="eager">
    <img class="mhs-botanical mhs-botanical--left-top" src="{{ 'morganics-morganics-hero-plant-left-top.png' | asset_url }}" alt="" width="577" height="433" loading="eager">
    <img class="mhs-botanical mhs-botanical--right" src="{{ 'morganics-morganics-hero-plant-right.png' | asset_url }}" alt="" width="577" height="433" loading="eager">
    <img class="mhs-botanical mhs-botanical--right-bottom" src="{{ 'morganics-morganics-hero-plant-right-bottom.png' | asset_url }}" alt="" width="577" height="433" loading="eager">
  </div>

  <aside class="mhs-spotlight" data-mhs-spotlight aria-hidden="true" aria-live="polite">
    <button class="mhs-spotlight-close" type="button" data-spotlight-close aria-label="Close ingredient details">×</button>
    <img class="mhs-spotlight-image" data-spotlight-image src="{{ 'almond.png' | asset_url }}" alt="" width="180" height="180">
    <div>
      <p class="mhs-spotlight-kicker">Featured ingredient</p>
      <h3 data-spotlight-title></h3>
      <a class="mhs-spotlight-link" data-spotlight-link href="{{ routes.all_products_collection_url }}">View product</a>
    </div>
  </aside>

  <script type="application/json" data-hero-config>
    {
      "sectionId": {{ section.id | json }},
      "autoplay": {{ section.settings.enable_autoplay | json }},
      "defaultDuration": {{ section.settings.default_duration | times: 1000 | json }},
      "pauseOnHover": {{ section.settings.pause_on_hover | json }},
      "pauseOnFocus": {{ section.settings.pause_on_focus | json }},
      "parallax": {{ section.settings.enable_parallax | json }},
      "floatingIngredients": {{ section.settings.enable_floating_ingredients | json }},
      "floatingAnimation": {{ section.settings.enable_floating_animation | json }},
      "burstGlow": {{ section.settings.enable_ingredient_burst_glow | json }},
      "ingredientCounts": {
        "desktop": {{ section.settings.desktop_ingredient_count | json }},
        "tablet": {{ section.settings.tablet_ingredient_count | json }},
        "mobile": {{ section.settings.mobile_ingredient_count | json }}
      },
      "ingredientSafeZones": {
        "desktop": { "left": {{ section.settings.ingredient_zone_desktop_left | json }}, "right": {{ section.settings.ingredient_zone_desktop_right | json }}, "top": {{ section.settings.ingredient_zone_desktop_top | json }}, "bottom": {{ section.settings.ingredient_zone_desktop_bottom | json }} },
        "mobile": { "left": {{ section.settings.ingredient_zone_mobile_left | json }}, "right": {{ section.settings.ingredient_zone_mobile_right | json }}, "top": {{ section.settings.ingredient_zone_mobile_top | json }}, "bottom": {{ section.settings.ingredient_zone_mobile_bottom | json }} }
      },
      "ingredientScale": {{ section.settings.ingredient_global_scale | divided_by: 100.0 | json }},
      "ingredientSpread": {{ section.settings.ingredient_blast_spread | divided_by: 100.0 | json }},
      "ingredientJitter": {{ section.settings.enable_ingredient_jitter | json }},
      "reduceMotion": {{ section.settings.reduce_motion | json }},
      "slides": [
        {% assign config_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'slide' and block.settings.enabled %}
            {% if config_index > 0 %},{% endif %}
            {"handle": {{ block.settings.slide_handle | handleize | json }}, "duration": {{ block.settings.duration | times: 1000 | json }}, "blockId": {{ block.id | json }}}
            {% assign config_index = config_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
</section>

<script src="{{ 'morganics-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Morganics Hero Slider",
  "tag": "section",
  "class": "shopify-section-morganics-hero-slider",
  "max_blocks": 50,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Morganics featured collections" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Enable autoplay", "default": true },
    { "type": "range", "id": "default_duration", "label": "Default slide duration", "min": 5, "max": 10, "step": 1, "unit": "s", "default": 7 },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 300, "max": 900, "step": 100, "unit": "ms", "default": 600 },
    { "type": "select", "id": "transition_style", "label": "Transition style", "default": "soft", "options": [{ "value": "fade", "label": "Fade" }, { "value": "soft", "label": "Fade and soften" }] },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover and focus", "default": true },
    { "type": "checkbox", "id": "pause_on_focus", "label": "Pause on keyboard focus", "default": true },
    { "type": "checkbox", "id": "enable_parallax", "label": "Enable subtle stage parallax", "default": true },
    { "type": "checkbox", "id": "enable_floating_ingredients", "label": "Enable floating ingredients", "default": true },
    { "type": "checkbox", "id": "enable_floating_animation", "label": "Enable floating ingredient animation", "default": true },
    { "type": "checkbox", "id": "enable_ingredient_burst_glow", "label": "Enable ingredient burst glow", "default": true },
    { "type": "range", "id": "desktop_ingredient_count", "label": "Desktop ingredient count", "min": 0, "max": 12, "step": 1, "default": 12 },
    { "type": "range", "id": "tablet_ingredient_count", "label": "Tablet ingredient count", "min": 0, "max": 8, "step": 1, "default": 8 },
    { "type": "range", "id": "mobile_ingredient_count", "label": "Mobile ingredient count", "min": 0, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "ingredient_zone_desktop_left", "label": "Desktop safe zone left", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 15 },
    { "type": "range", "id": "ingredient_zone_desktop_right", "label": "Desktop safe zone right", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 18 },
    { "type": "range", "id": "ingredient_zone_desktop_top", "label": "Desktop safe zone top", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 4 },
    { "type": "range", "id": "ingredient_zone_desktop_bottom", "label": "Desktop safe zone bottom", "min": 0, "max": 25, "step": 1, "unit": "%", "default": 8 },
    { "type": "range", "id": "ingredient_zone_mobile_left", "label": "Mobile safe zone left", "min": 0, "max": 18, "step": 1, "unit": "%", "default": 4 },
    { "type": "range", "id": "ingredient_zone_mobile_right", "label": "Mobile safe zone right", "min": 0, "max": 18, "step": 1, "unit": "%", "default": 4 },
    { "type": "range", "id": "ingredient_zone_mobile_top", "label": "Mobile safe zone top", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 14 },
    { "type": "range", "id": "ingredient_zone_mobile_bottom", "label": "Mobile safe zone bottom", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 18 },
    { "type": "range", "id": "ingredient_global_scale", "label": "Global ingredient scale", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "ingredient_blast_spread", "label": "Blast spread intensity", "min": 70, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "enable_ingredient_jitter", "label": "Enable ingredient random jitter", "default": true },
    { "type": "checkbox", "id": "show_tagline", "label": "Show slide tagline", "default": true },
    { "type": "checkbox", "id": "show_ctas", "label": "Show CTA buttons", "default": false },
    { "type": "select", "id": "desktop_navigator_position", "label": "Desktop navigator position", "default": "right", "options": [{ "value": "right", "label": "Right side" }, { "value": "far-right", "label": "Far right" }] },
    { "type": "select", "id": "mobile_navigator_style", "label": "Mobile navigator style", "default": "scroll-row", "options": [{ "value": "scroll-row", "label": "Horizontal scroll row" }, { "value": "compact-grid", "label": "Compact grid" }] },
    { "type": "range", "id": "background_overlay_strength", "label": "Default background overlay strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "checkbox", "id": "reduce_motion", "label": "Reduce hero motion", "default": false },
    { "type": "range", "id": "stage_max_width", "label": "Stage maximum width", "min": 520, "max": 1040, "step": 20, "unit": "px", "default": 980 },
    { "type": "range", "id": "stage_safe_margin", "label": "Stage side safe margin", "min": 20, "max": 40, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "ingredient_safe_margin", "label": "Ingredient edge margin", "min": 20, "max": 44, "step": 2, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero slide",
      "limit": 8,
      "settings": [
        { "type": "checkbox", "id": "enabled", "label": "Enable slide", "default": true },
        { "type": "text", "id": "slide_handle", "label": "Unique slide handle", "info": "Use this exact handle on related ingredient and quicklink blocks.", "default": "nature" },
        { "type": "text", "id": "title_line_1", "label": "Title line 1", "default": "Rooted in" },
        { "type": "text", "id": "title_line_2", "label": "Title line 2", "default": "Nature" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Premium nuts, dry fruits and wellness essentials for a healthier tomorrow" },
        { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Shop now" },
        { "type": "url", "id": "primary_cta_link", "label": "Primary CTA link" },
        { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label" },
        { "type": "url", "id": "secondary_cta_link", "label": "Secondary CTA link" },
        { "type": "text", "id": "navigator_title", "label": "Navigator card title", "info": "Keep the default value to use title line 2.", "default": "Use title line 2" },
        { "type": "select", "id": "navigator_category_icon", "label": "Navigator card icon", "default": "nuts", "options": [{ "value": "nuts", "label": "Premium nuts" }, { "value": "dry-fruits", "label": "Dry fruits" }, { "value": "roots", "label": "Roots and adaptogens" }, { "value": "seeds", "label": "Seeds and grains" }, { "value": "herbs", "label": "Herbs and botanicals" }, { "value": "sweeteners", "label": "Natural sweeteners" }, { "value": "oils", "label": "Oils and specialties" }] },
        { "type": "image_picker", "id": "navigator_icon", "label": "Custom navigator icon" },
        { "type": "text", "id": "tagline_small", "label": "Tagline small text", "default": "Driven by" },
        { "type": "text", "id": "tagline_large", "label": "Tagline large text", "default": "Wellness" },
        { "type": "range", "id": "duration", "label": "Slide duration", "min": 0, "max": 10, "step": 1, "unit": "s", "info": "Set to 0 to use the section default.", "default": 0 },
        { "type": "image_picker", "id": "background_image", "label": "Background image" },
        { "type": "range", "id": "overlay_strength", "label": "Background overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
        { "type": "image_picker", "id": "pouch_image", "label": "Pouch image" },
        { "type": "text", "id": "pouch_alt", "label": "Pouch alt text", "default": "Morganics premium organic pouch" },
        { "type": "image_picker", "id": "stone_image", "label": "Base stone image" },
        { "type": "image_picker", "id": "pile_image", "label": "Dry fruit pile image" },
        { "type": "image_picker", "id": "foreground_image", "label": "Optional foreground pile" }
      ]
    },
    {
      "type": "ingredient",
      "name": "Hero ingredient",
      "limit": 36,
      "settings": [
        { "type": "text", "id": "slide_handle", "label": "Slide handle", "default": "nature" },
        { "type": "image_picker", "id": "image", "label": "Ingredient image" },
